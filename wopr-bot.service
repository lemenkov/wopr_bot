[Unit]
Description=WOPR Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/sysconfig/wopr-bot
WorkingDirectory=/opt/wopr_bot
ExecStart=/usr/bin/python3 joshua_bot.py
Restart=on-failure
RestartSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wopr_bot

[Install]
WantedBy=multi-user.target
